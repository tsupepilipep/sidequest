# Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Server-only. Used by the API routes and scripts/seed-segments.ts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only, local scripts only. Postgres connection string for `pnpm migrate`
# (Supabase dashboard -> Connect -> Session pooler). Not needed on Vercel.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-your-region.pooler.supabase.com:5432/postgres
